# Synthetic Intelligence (SI) layer — local gateways.
# Copy to backend/.env (loaded automatically by services/si_copilot.py).
# Both services are optional: with either down the API serves the
# deterministic offline fallback built on tactics.py + neighbors.py.

# 9Router — OpenAI-compatible local LLM gateway
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=local-9router-key
# Model or alias configured inside 9Router ("auto" lets the router pick)
NINE_ROUTER_MODEL=auto

# whisper.cpp server — STT endpoint. Route depends on the build:
# newer builds serve the OpenAI-compat /v1/audio/transcriptions,
# others only /inference — both take multipart `file` +
# `response_format=json` and return {"text": ...}. See docs/SI_SETUP.md.
WHISPER_CPP_URL=http://localhost:8081/inference

# Optional timeouts (seconds)
# SI_LLM_TIMEOUT_S=12
# SI_STT_TIMEOUT_S=45

# --- cloud providers (deployed API — see docs/DEPLOY.md) -----------------
# Any OpenAI-compatible base URL works in NINE_ROUTER_BASE_URL; free
# tiers that need no local gateway:
#   Gemini: NINE_ROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#           NINE_ROUTER_API_KEY=<AI Studio key>  NINE_ROUTER_MODEL=gemini-2.5-flash
#   Groq:   NINE_ROUTER_BASE_URL=https://api.groq.com/openai/v1
#           NINE_ROUTER_API_KEY=<console key>    NINE_ROUTER_MODEL=llama-3.3-70b-versatile
# (both are examples — use any current chat model id from the provider)
#
# CORS_ORIGINS — comma-separated frontend origins allowed to call the
# API cross-origin (default: vite dev ports). Production example:
#   CORS_ORIGINS=https://your-app.vercel.app
