{
  "schema": "ignis.pixi.shipyard-takes",
  "schemaVersion": 1,
  "renderer": "PixiJS 8",
  "artDirection": {
    "styleGuide": "design/guias/visual/GUIA_VISUAL_IGNIS.md",
    "perspective": "2.5D orbital scene",
    "palette": ["#0B1220", "#CBD5E1", "#56677D", "#49B8D6", "#F3BE5A"]
  },
  "layers": [
    "station-background",
    "starfield",
    "comets",
    "ships",
    "engine-fire",
    "station-foreground"
  ],
  "takes": [
    { "id": "macro", "label": "Take 1: Overview", "focus": "station", "scale": 1.0 },
    { "id": "patrol", "label": "Take 2: Rear Patrol", "focus": "patrol", "scale": 1.3 },
    { "id": "toroidal", "label": "Take 3: Toroidal Center Passage", "focus": "scout", "scale": 1.45 },
    { "id": "thrusters", "label": "Take 4: Engine Burn", "focus": "patrol", "scale": 1.5 },
    { "id": "thrusters-close", "label": "Take 5: Thruster Close-up", "focus": "patrol", "scale": 1.9 },
    { "id": "thrusters-burn", "label": "Take 6: Full Burn", "focus": "patrol", "scale": 1.25 },
    { "id": "comets", "label": "Take 7: Background Comets", "focus": "space", "scale": 0.95 },
    { "id": "comets", "label": "Take 7: Background Comets", "focus": "space", "scale": 0.95 }
  ],
  "sequences": {
    "starfield_twinkle": {
      "kind": "procedural",
      "count": 220,
      "fps": 12,
      "loop": true,
      "palette": ["#FFFFFF", "#8BE9FD", "#FFB86C"]
    },
    "ship_flight": {
      "kind": "path-animation",
      "loop": true,
      "ships": [
        { "id": "patrol", "asset": "assets/space/naves/ship_science_patrol.png", "path": "upper-sweep", "speed": 0.0003 },
        { "id": "scout", "asset": "assets/space/naves/ship_scout_interceptor.png", "path": "toroidal-crossing", "speed": 0.00055 },
        { "id": "cargo", "asset": "assets/space/naves/ship_heavy_cargo.png", "path": "deep-orbit-sweep", "speed": 0.00018 },
        { "id": "recon", "asset": "assets/space/naves/ship_recon_corvette.png", "path": "antenna-orbit", "speed": 0.00045 }
      ]
    },
    "engine_fire": {
      "kind": "timed-burst",
      "fps": 7,
      "loop": true,
      "periodMs": 8000,
      "burstDurationMs": 800,
      "idleMs": 7200,
      "frameSequence": ["idle", "ignition", "burn", "fade"],
      "frames": [
        "assets/space/motores/fx_thruster_idle.png",
        "assets/space/motores/fx_thruster_cruising.png",
        "assets/space/motores/fx_thruster_full_burn.png",
        "assets/space/motores/fx_thruster_boost.png"
      ],
      "flare": "assets/space/motores/fx_thruster_flare.png"
    },
    "asteroid_flyby": {
      "kind": "path-animation",
      "loop": false,
      "path": "left-to-right-shallow-arc",
      "speedRange": [1.2, 2.0],
      "scaleRange": [0.035, 0.055],
      "asset": "assets/space/asteroides/fx_asteroid_small.png",
      "spawnChance": { "normal": 0.22, "high": 0.22 },
      "description": "Pequeno asteroide rochoso ocasional; não é cometa e não emite brilho próprio."
    },
    "station_float": {
      "kind": "procedural",
      "loop": true,
      "amplitudePx": 3,
      "periodFrames": 418
    }
  },
  "commands": [
    { "key": "1-7", "action": "select-take" },
    { "key": "Space", "action": "play-pause" },
    { "key": "T", "action": "toggle-engine-fire" },
    { "key": "C", "action": "cycle-comet-rate" },
    { "key": "-", "action": "slower" },
    { "key": "+", "action": "faster" }
  ],
  "continuity": {
    "shipsBehindStationForeground": true,
    "effectsBehindStationForeground": true,
    "pauseFreezesAmbientMotion": true,
    "takeIdsMatchSceneControls": true
  }
}
