# Backend origin when the site is deployed separately from the API
# (Vercel frontend → Hugging Face Space / Render backend). REST calls
# use it verbatim; the /ws/chamber socket maps https→wss automatically.
# Leave unset for local dev — vite proxies /api, /health and /ws to :8000.
VITE_API_URL=https://your-space-name.hf.space
